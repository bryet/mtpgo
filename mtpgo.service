[Unit]
Description=Mtpgo Service
Wants=network-online.target
After=network-online.target

[Service]
User=mtpgo
Group=mtpgo
WorkingDirectory=/var/mtpgo
Environment=MTPGO_LOG_DIR=/var/log/mtpgo
LogsDirectory=mtpgo
LogsDirectoryMode=0700
RuntimeDirectory=mtpgo
RuntimeDirectoryMode=0700
ExecStartPre=/var/mtpgo/mtpgo -check -c /var/mtpgo/config.ini
ExecStart=/var/mtpgo/mtpgo -c /var/mtpgo/config.ini
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadWritePaths=/var/log/mtpgo /run/mtpgo

[Install]
WantedBy=multi-user.target
